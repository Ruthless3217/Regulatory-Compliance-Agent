# Database
DB_USER=compliance_user
DB_PASS=compliance_pass
DB_NAME=compliance_db
DB_HOST=localhost
DB_PORT=5432

# LLM Configuration (Use ONE of the options below)

# Option A: Google Gemini 2.0 (Default)
LLM_API_KEY=your_google_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# Option B: Local Fine-Tuned Model (e.g., Qwen 3.5 via Ollama/vLLM)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=your_fine_tuned_qwen_model_name


# Redis (LangGraph Persistence)
REDIS_URL=redis://localhost:6379

# Firebase Auth (optional)
FIREBASE_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# LangSmith Tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=regulatory-compliance-agent

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
