# Database
DB_USER=compliance_user
DB_PASS=compliance_pass
DB_NAME=compliance_db
DB_HOST=localhost
DB_PORT=5432

# LLM Configuration (Use ONE of the options below)
#
# LLM_API_KEY accepts a single key OR a comma-separated list. With multiple
# keys the service fails over automatically on HTTP 429.

# Option A: Azure OpenAI (Default — analysis / grading pipeline)
# LLM_BASE_URL is the resource ROOT (no /openai/v1). LLM_MODEL is the deployment.
LLM_PROVIDER=azure
LLM_API_KEY=your_azure_api_key_here
LLM_BASE_URL=https://<your-azure-resource>.openai.azure.com
LLM_MODEL=gpt-5.4
LLM_CLASSIFY_MODEL=gpt-5.4-nano
LLM_AZURE_API_VERSION=2025-04-01-preview
LLM_USE_MAX_COMPLETION_TOKENS=true
LLM_SUPPORTS_TEMPERATURE=false
LLM_REASONING_EFFORT=low

# Option B: Local model via Ollama (backup fallback)
# LLM_PROVIDER=openai
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct

# RAG embeddings — Cohere embed v3 via Azure AI Foundry inference (1024-dim).
# Leave AZURE_INFERENCE_API_KEY blank to reuse LLM_API_KEY (same resource).
RAG_EMBEDDING_PROVIDER=azure_cohere
RAG_EMBEDDING_MODEL=embed-english-v3.0
RAG_EMBEDDING_DIM=1024
AZURE_INFERENCE_ENDPOINT=https://<your-azure-resource>.services.ai.azure.com/models
AZURE_INFERENCE_API_KEY=
AZURE_INFERENCE_API_VERSION=2024-05-01-preview
AZURE_COHERE_EMBED_DEPLOYMENT=<cohere-embed-v3-deployment-name>


# Dual-model critic: gpt-5.4-nano deployment on the same Azure resource as the
# main gpt-5.4 generator. Only the deployment name differs; the rest inherits LLM_*.
# Fill in your actual nano Azure deployment name. If left empty the critic runs
# on the main model (no second model). LLM_CRITIC_ENABLED toggles it on/off.
CRITIC_LLM_MODEL=
LLM_CRITIC_ENABLED=true

# Redis (LangGraph Persistence)
REDIS_URL=redis://localhost:6379

# Firebase Auth (optional)
FIREBASE_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# LangSmith Tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=regulatory-compliance-agent

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Precedent compliance engine (Phase 1)
PGVECTOR_TOP_K=5
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_BATCH_SIZE=100
KB_MIN_FUZZY_SCORE=60
VIZ_POINTS_PER_INDEX=2000
