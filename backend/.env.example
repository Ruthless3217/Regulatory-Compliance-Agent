# Database
DB_USER=compliance_user
DB_PASS=compliance_pass
DB_NAME=compliance_db
DB_HOST=localhost
DB_PORT=5432

# LLM Configuration (Use ONE of the options below)
#
# LLM_API_KEY accepts a single key OR a comma-separated list. With multiple
# keys the service fails over automatically: when one Groq key hits its TPM/TPD
# limit (HTTP 429) the next key takes over. Each key keeps an independent
# token budget. Example: LLM_API_KEY=gsk_keyA, gsk_keyB

# Option A: Google Gemini 2.0 (Default)
LLM_API_KEY=your_google_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# Option B: Local Fine-Tuned Model (e.g., Qwen 3.5 via Ollama/vLLM)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=your_fine_tuned_qwen_model_name


# Dual-model critic: gpt-5.4-nano deployment on the same Azure resource as the
# main gpt-5.4 generator. Only the deployment name differs; the rest inherits LLM_*.
# Fill in your actual nano Azure deployment name. If left empty the critic runs
# on the main model (no second model). LLM_CRITIC_ENABLED toggles it on/off.
CRITIC_LLM_MODEL=
LLM_CRITIC_ENABLED=true

# Redis (LangGraph Persistence)
REDIS_URL=redis://localhost:6379

# Firebase Auth (optional)
FIREBASE_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# LangSmith Tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=regulatory-compliance-agent

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Precedent compliance engine (Phase 1)
PGVECTOR_TOP_K=5
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_BATCH_SIZE=100
KB_MIN_FUZZY_SCORE=60
VIZ_POINTS_PER_INDEX=2000
