# ──────────────────────────────────────────────────────────────────────────
# .env.shared.example  →  copy to .env when deploying with
# docker-compose.shared.yml on the Bajaj AI Platform VM.
#
#     cp .env.shared.example .env   &&   nano .env
#
# .env is git-ignored. DATABASE_URL / REDIS_URL are forced by the compose file
# (they point at shared-postgres / shared-redis), so the values here are only
# used when running the backend outside docker.
# ──────────────────────────────────────────────────────────────────────────

# ── Main LLM provider — Azure OpenAI (analysis / grading pipeline) ──────────
# All models live in one Azure AI Foundry project. LLM_BASE_URL is the Azure
# OpenAI RESOURCE ROOT (no /openai/v1 path). LLM_MODEL is the DEPLOYMENT name.
LLM_PROVIDER=azure
LLM_BASE_URL=https://<your-azure-resource>.openai.azure.com
LLM_MODEL=gpt-5.4
# Cheap/fast second pass (generator-critic). Empty → reuse LLM_MODEL.
LLM_CLASSIFY_MODEL=gpt-5.4-nano
LLM_API_KEY=<azure-api-key>
LLM_AZURE_API_VERSION=2025-04-01-preview
LLM_USE_MAX_COMPLETION_TOKENS=true
LLM_SUPPORTS_TEMPERATURE=false
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=8000
LLM_CONTEXT_WINDOW=128000
# true if behind Cisco Umbrella SSL inspection without trusted certs.
LLM_INSECURE_TLS=true

# ── Ollama backup (local fallback) ─────────────────────────────────────────
# If Azure is unreachable, comment the Azure LLM_* block and uncomment this.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=ollama
# LLM_USE_MAX_COMPLETION_TOKENS=false
# LLM_SUPPORTS_TEMPERATURE=true
# LLM_REASONING_EFFORT=

# ── Database / cache ───────────────────────────────────────────────────────
# Must match COMPLIANCE_DB_PASSWORD in /opt/shared/.env (compliance_user role).
COMPLIANCE_DB_PASSWORD=compliance_pass
# Only used by the standalone compose / outside-docker runs.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://compliance_user:compliance_pass@localhost:5432/compliance_db
REDIS_URL=redis://localhost:6379
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── RAG / embeddings — Cohere embed v3 via Azure AI Foundry inference ───────
# Cohere is served from the Foundry MODELS endpoint, NOT .openai.azure.com.
# 1024-dim (same as public embed-english-v3.0) → no re-index for the english
# variant. Leave AZURE_INFERENCE_API_KEY blank to reuse LLM_API_KEY.
AZURE_INFERENCE_ENDPOINT=https://<your-azure-resource>.services.ai.azure.com/models
AZURE_INFERENCE_API_KEY=
AZURE_INFERENCE_API_VERSION=2024-05-01-preview
AZURE_COHERE_EMBED_DEPLOYMENT=<cohere-embed-v3-deployment-name>
AZURE_COHERE_RERANK_DEPLOYMENT=<cohere-rerank-v4-deployment-name>
RAG_EMBEDDING_PROVIDER=azure_cohere
RAG_EMBEDDING_MODEL=embed-english-v3.0
RAG_EMBEDDING_DIM=1024

# ── LangSmith tracing (optional) ───────────────────────────────────────────
LANGCHAIN_API_KEY=<langsmith-key>
LANGCHAIN_PROJECT=Regulatory Compliance Agent
LANGSMITH_PROJECT_ID=<langsmith-project-id>
LANGCHAIN_TRACING_V2=false
CRITIC_ENABLED=true
