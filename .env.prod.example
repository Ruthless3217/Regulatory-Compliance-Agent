# ---------------------------------------------------------------------------
# Production env template for docker-compose.prod.yml
#
#   cp .env.prod.example .env      # then fill in the real values below
#
# NEVER commit the filled-in .env (it is gitignored). These are PLACEHOLDERS.
# docker compose reads this file from the repo root automatically.
# ---------------------------------------------------------------------------

# --- Image version to run (must match the tag you built/loaded) ---
IMAGE_TAG=v1
BUILD_SHA=prod

# --- Postgres credentials (used by postgres + backend + db-backup) ---
# CHANGE THIS from the dev default before any real deployment.
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=compliance_db

# --- Main LLM provider (analysis / grading) ---------------------------------
# Default deployment: Azure OpenAI (gpt-5.4). LLM_BASE_URL is the resource ROOT
# (no /openai/... path); LLM_MODEL is the DEPLOYMENT name, not the model family.
# gpt-5.4 is a reasoning model → it needs max_completion_tokens (not max_tokens).
LLM_PROVIDER=azure
LLM_BASE_URL=https://bl-prod02-opai-bajaj-compliance-app-01.openai.azure.com
LLM_MODEL=gpt-5.4
LLM_API_KEY=change_me_azure_api_key
LLM_AZURE_API_VERSION=2025-04-01-preview
LLM_USE_MAX_COMPLETION_TOKENS=true
# gpt-5.4 reasoning mode only allows default temperature (1) — omit the param.
LLM_SUPPORTS_TEMPERATURE=false
# Reasoning effort = the main cost lever (high ≈ 5x low's output tokens on the
# same task). low = sharp + cheap; minimal = cheapest (0 reasoning); medium/high
# pricier. Leave EMPTY for non-reasoning providers (Groq llama rejects it).
LLM_REASONING_EFFORT=low
# Safety ceiling only — billed on tokens ACTUALLY generated, not this cap.
LLM_MAX_TOKENS=8000
LLM_CONTEXT_WINDOW=128000
# Set true ONLY if the LLM endpoint sits behind SSL inspection without trusted
# certs baked into the image (the image already trusts Bajaj + Cisco Umbrella).
LLM_INSECURE_TLS=false
#
# Alternative provider (OpenAI-compatible: Ollama / Groq / internal gateway):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://host.docker.internal:11434/v1   # or https://api.groq.com/openai/v1
#   LLM_MODEL=gemma4:31b-cloud
#   LLM_API_KEY=key1,key2          # comma-separated enables failover
#   LLM_USE_MAX_COMPLETION_TOKENS=false

# --- Chat assistant LLM (streaming Q&A) -------------------------------------
# Runs on a SEPARATE provider from analysis. Leave any CHAT_LLM_* empty to make
# chat inherit the main LLM_* config above. Configured here for Groq.
CHAT_LLM_PROVIDER=openai
CHAT_LLM_BASE_URL=https://api.groq.com/openai/v1
CHAT_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
CHAT_LLM_API_KEY=change_me_groq_key1,change_me_groq_key2
CHAT_LLM_MAX_TOKENS=8000
CHAT_LLM_INSECURE_TLS=false
GROQ_CITATION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_CITATION_TPM=30000

# --- RAG / embeddings -------------------------------------------------------
# Cohere is a CLOUD API — the host/VM needs network access to api.cohere.com
# (and the cert is baked into the backend image). Without it, RAG retrieval is
# degraded. Provide a key, or switch RAG_EMBEDDING_PROVIDER to openai.
RAG_EMBEDDING_PROVIDER=cohere
RAG_EMBEDDING_MODEL=embed-english-v3.0
RAG_EMBEDDING_DIM=1024
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_API_KEY=
OPENAI_API_KEY=

# --- LangSmith tracing (optional; leave disabled offline) -------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Regulatory Compliance Agent

# --- Feature flags ----------------------------------------------------------
CRITIC_ENABLED=true
COMPLETENESS_SWEEP_ENABLED=true
CROSS_CHUNK_CONTEXT_ENABLED=true
CROSS_CHUNK_CONTEXT_TOKEN_BUDGET=8000
LOG_LEVEL=INFO

# --- Auth, sessions & RBAC (audit-trail) ------------------------------------
# Enforce login. Set false ONLY for a controlled dev/UAT cutover; never in a
# shared environment.
AUTH_ENABLED=true
# IP binding on login: strict | cidr | list | log_only  (strict = one registered
# IP per user, admin-updatable — the default).
AUTH_IP_BINDING_MODE=strict
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Requires TLS terminated at nginx (Secure cookie won't send over plain HTTP).
SESSION_COOKIE_SECURE=true
# Trust X-Forwarded-For ONLY because a trusted nginx sets it. If the app is ever
# exposed directly this MUST be false (XFF becomes client-spoofable).
TRUST_FORWARDED_FOR=true
# Lock CORS to the exact UAT origin(s); allow_credentials=True is incompatible
# with "*". Comma-separated; JSON list also accepted by pydantic-settings.
API_CORS_ORIGINS=["https://compliance.internal.bajajlife.com"]

# --- First super-admin bootstrap (read ONLY by scripts/seed_super_admin.py) --
# Run once after `alembic upgrade head`: `python -m scripts.seed_super_admin`.
# The account is created with must_change_password=true. NEVER commit real values.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_IP=

# --- LLM cost model (USD per 1,000 tokens; fill from your billing contract) ---
# JSON map: {model: {"input": x, "output": y}} + a "_default". Unknown models
# fall back to "_default" and are flagged price_source=default in the ledger.
LLM_PRICES={"gpt-5.4":{"input":0.0,"output":0.0},"gpt-5.4-nano":{"input":0.0,"output":0.0},"_default":{"input":0.0,"output":0.0}}
LLM_PRICE_CURRENCY=USD
