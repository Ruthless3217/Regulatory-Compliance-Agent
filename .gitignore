# Build / deploy artifacts (Docker image tarballs — rebuilt on demand, >100MB)
dist/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
*.log

# VS Code / IDEs
.vscode/
.idea/
*.swp
*.swo

# Superseded / experimental frontend — not built or deployed by any compose
frontend-v2/

# Playwright MCP page dumps (debug artifacts)
.playwright-mcp/

# OS generated files
.DS_Store
Thumbs.db

# Precedent corpus — large reviewer-decision dataset, kept out of the repo
# (it is an embedded git repo; tracking it would record a broken gitlink).
/dataset/

# Build artifacts
*.tsbuildinfo

# Runtime/debug artifacts
latest_calls.txt
ingestion_dataset
# PII / sensitive data — never track (user-uploaded customer docs, DB dumps)
backend/uploads/
backend/backups/

# Generated exports
exports/
backend/exports/

# PDFs (brochures, reference docs — large binaries, never track)
*.pdf

# Large input corpora / source documents (never track)
docs/downloads/
docs/ledger/

# Runtime logs
backend/logs/
logs/

# Git worktrees (superpowers:using-git-worktrees)
.worktrees/
